# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名可在 GUI「连接设置」点「刷新模型」从接口拉取；当前账户支持 deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
# 图片识别模型
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# QQ Bot 配置 (OneBot v11 正向 WebSocket，与 NapCat config/onebot11_*.json 保持一致)
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=你的token

# 对话配置
# 对话记忆轮数（1轮=2条消息；500轮 = 上下文保留最近 1000 条原文，重启后也能恢复）
MAX_HISTORY_LENGTH=500
TEMPERATURE=0.9
MAX_TOKENS=256

# 阿里云百炼 DashScope
DASHSCOPE_API_KEY=sk-你的百炼key
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
